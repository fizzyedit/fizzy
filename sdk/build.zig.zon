.{
    .name = .fizzy,
    .version = "0.2.0",
    .fingerprint = 0x3311781b63706048,
    .minimum_zig_version = "0.17.0",
    // Plugin SDK package — no app-only deps (Velopack, nightwatch, …). Plugins depend on
    // this directory; the repo-root zon owns the editor build. See AGENTS.md.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "plugin_sdk.zig",
        "core_module.zig",
        "replay_module.zig",
        "plugin_sdk_meta.zig",
        "plugin_sdk_check.zig",
        "plugin_sdk_install.zig",
        "sdk_version.zig",
        "manifest_identity.zig",
        "paths.zig",
        "src",
        "tape",
        "remote",
        "replay",
    },
    .dependencies = .{
        .icons = .{
            .url = "https://github.com/fizzyedit/icons/archive/41e7d2162b121e3798438a7da25ff4648b204dc7.tar.gz",
            .hash = "icons-0.1.0-iJxA-Z0TNABnFm_tPfx46ZnvojHweT6xON9ay91XZ4Xo",
            .lazy = true,
        },
        // The repo's ONLY dvui pin — bump or repoint it here and nowhere else. dvui is deliberately
        // absent from the root zon: the app consumes this package and borrows this entry through
        // `build/sdk.zig`'s `dvuiDependency`, and build scripts take dvui's build API from
        // `sdk/build.zig`'s re-export. Do not add `.dvui` back to the root zon to "fix" that.
        //
        // It lives here rather than there because this directory ships standalone as
        // `fizzy-sdk-v*.tar.gz` and cannot reach anything above its own root, while the app can
        // always reach down into it.
        // Pinned by commit, kept alive by a tag. GitHub serves `/archive/<sha>.tar.gz` only while
        // that commit is reachable from some ref, so every commit pinned here gets an immutable
        // `fizzy-sdk-<version>` tag in the fork before the pin lands. `fizzy-dev` itself stays a
        // working branch and can be rebased freely — the tag, never.
        .dvui = .{
            // The zig-0.17 branch: fizzy-sdk-0.2.30-7 and the floating window background hook after
            // it (docs/DEPENDENCIES.md, patch 14)
            .url = "git+https://github.com/foxnne/dvui-dev#3d90fdda949d50ba7fa82117ccb18a40da5b41cc",
            .hash = "dvui-0.6.0-dev-AQFJmTG2BAHCy_MTZv6SjCTs3xHXSOPuxEsON67RQ7uS",
            //.path = "../../dvui-dev",
        },
        .zf = .{
            .url = "git+https://github.com/natecraddock/zf#e00f9e978b6a7126d1b35fa8ffd49b62042ad6f3",
            .hash = "zf-0.11.0-OIRy8XCRAAB6FiMwIrtD6FqlagnFwpI6YyOu7bXeYH5J",
        },
    },
}
