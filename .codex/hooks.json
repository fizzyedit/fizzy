{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/foxnne/dev/fizzy/.codex/hooks/guard-bash.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/foxnne/dev/fizzy/.codex/hooks/zig-fmt.sh'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
