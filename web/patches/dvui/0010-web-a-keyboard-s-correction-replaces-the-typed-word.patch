+/**
+ * Keeps the hidden input showing the word before the caret, and turns what a phone keyboard
+ * does to that word into the edits dvui's text widgets understand.
+ *
+ * The widgets draw their own text, so the input is empty and a keyboard has nothing to
+ * correct: autocorrect or a suggestion then arrives as plain new text ("im" becomes "imI'm").
+ * The input holds the word typed since the last space instead, the caret at its end, so a
+ * keyboard replaces it, and a replacement is sent as that many backspaces and then the new
+ * text. The word is only what this class has seen typed; a caret moved by a pointer or a key,
+ * or a delete it cannot follow, clears it.
+ */
+export class TextInput {
+    /** The word before the caret, as the hidden input shows it. */
+    word = "";
+    /** @type {boolean} */
+    composing = false;
+    /** A Backspace keydown not yet matched by its `deleteContentBackward`. */
+    backspaceKey = false;
+
+    /**
+     * @param {HTMLInputElement} hidden
+     * @param {{text: (text: string) => void, backspace: () => void}} sink Where the edits go.
+     */
+    constructor(hidden, sink) {
+        this.hidden = hidden;
+        this.sink = sink;
+        hidden.addEventListener("beforeinput", (ev) => this.beforeInput(ev));
+        hidden.addEventListener("compositionstart", () => { this.composing = true; });
+        hidden.addEventListener("compositionend", (ev) => this.compositionEnd(ev));
+        hidden.addEventListener("blur", () => this.clear());
+    }
+
+    /** Forget the word: the caret moved, or the field changed. */
+    clear() {
+        this.word = "";
+        if (!this.composing && this.hidden.value !== "") this.hidden.value = "";
+    }
+
+    /** Called for every keydown on the canvas or the hidden input. */
+    keydown(ev) {
+        if (this.composing || ["Shift", "Control", "Alt", "Meta", "CapsLock", "Unidentified", "Process", "Dead"].includes(ev.key)) return;
+        if (ev.key === "Backspace" && !ev.ctrlKey && !ev.altKey && !ev.metaKey) {
+            this.backspaceKey = true;
+            this.set(Array.from(this.word).slice(0, -1).join(""));
+        } else if (ev.key.length > 1 || ev.ctrlKey || ev.metaKey) {
+            this.clear();
+        }
+    }
+
+    set(word) {
+        this.word = word;
+        if (!this.composing && this.hidden.value !== word) this.hidden.value = word;
+    }
+
+    /** The word after `text` is typed at the caret. */
+    typed(text) {
+        this.set((this.word + text).split(/\s/).pop());
+    }
+
+    /** Replace [start, end) of the word with `text`: the deleted tail, then the text. */
+    replace(start, end, text) {
+        // The DOM counts UTF-16 code units, so slice the string by them; the keyboard erases code points.
+        start = Math.max(0, Math.min(start, this.word.length));
+        end = Math.max(start, Math.min(end, this.word.length));
+        // The caret is at the end of the word, so what follows `end` goes too and comes back.
+        const after = this.word.slice(end);
+        const kept = this.word.slice(0, start);
+        const deleted = Array.from(this.word.slice(start)).length;
+        for (let i = 0; i < deleted; i++) this.sink.backspace();
+        this.sink.text(text + after);
+        this.set(kept);
+        this.typed(text + after);
+    }
+
+    beforeInput(ev) {
+        ev.preventDefault();
+        if (ev.isComposing) return;
+        const type = ev.inputType;
+        if (type === "deleteContentBackward") {
+            // Soft keyboards usually send the Backspace key as well, which has popped the word.
+            if (this.backspaceKey) this.backspaceKey = false;
+            else this.set(Array.from(this.word).slice(0, -1).join(""));
+            return;
+        }
+        if (type && type.startsWith("delete")) {
+            this.clear();
+            return;
+        }
+        let text = ev.data;
+        if (text == null && type === "insertReplacementText" && ev.dataTransfer) text = ev.dataTransfer.getData("text/plain");
+        if (!text) return;
+        if (type === "insertReplacementText") {
+            // For an input the target ranges are empty; the keyboard selects what it replaces.
+            const ranges = ev.getTargetRanges ? ev.getTargetRanges() : [];
+            const start = ranges.length > 0 ? ranges[0].startOffset : this.hidden.selectionStart;
+            const end = ranges.length > 0 ? ranges[0].endOffset : this.hidden.selectionEnd;
+            if (start != null && end != null && start < end) {
+                this.replace(start, end, text);
+                return;
+            }
+        }
+        this.sink.text(text);
+        this.typed(text);
+    }
+
+    compositionEnd(ev) {
+        this.composing = false;
+        // The input now holds the word as the keyboard composed it. Whatever it shares with the
+        // word the widgets have is untouched; the rest of ours is deleted and theirs typed.
+        const had = Array.from(this.word);
+        let now = Array.from(this.hidden.value);
+        if (now.length === 0 && had.length === 0 && ev.data) now = Array.from(ev.data);
+        let same = 0;
+        while (same < had.length && same < now.length && had[same] === now[same]) same++;
+        for (let i = same; i < had.length; i++) this.sink.backspace();
+        const text = now.slice(same).join("");
+        if (text) this.sink.text(text);
+        this.word = "";
+        this.typed(now.join(""));
+    }
+}
