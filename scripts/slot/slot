#!/usr/bin/env python3
"""Dispatch trusted slot validation and publishing commands."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
if len(sys.argv) < 2 or sys.argv[1] not in ('validate', 'publish'):
    print('usage: slot {validate|publish} ...', file=sys.stderr)
    sys.exit(2)
command = sys.argv.pop(1)
if command == 'validate':
    from slot.validate import main
else:
    from slot.publish import main
sys.exit(main())
