#!/usr/bin/env python3
"""Slot protocol command dispatcher."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if __name__ == '__main__':
    if len(sys.argv) < 2 or sys.argv[1] not in ('run', 'validate', 'publish'):
        print('usage: slot {run|validate|publish} ...', file=sys.stderr)
        sys.exit(2)
    command = sys.argv.pop(1)
    if command == 'run':
        from slot.slot_run import main
    elif command == 'validate':
        from slot.validate import main
    else:
        from slot.publish import main
    sys.exit(main())
