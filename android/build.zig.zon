.{
    .name = .fizzy_android,
    .version = "0.0.0",
    .fingerprint = 0x36a9f709a8abf1e4,
    .minimum_zig_version = "0.17.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "src",
        "AndroidManifest.xml",
    },
    // The repo's one dvui is pinned in `sdk/build.zig.zon`; this package reaches it through the SDK
    // package (as `build/sdk.zig`'s `dvuiDependency` does), so it cannot drift from fizzy's.
    .dependencies = .{
        .fizzy_sdk = .{ .path = "../sdk" },
    },
}
