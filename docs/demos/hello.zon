// A demo tape written by hand: the format `app.automation.Tape` reads (`Tape.parse`) and writes
// (`Tape.write`), and what a recorder will produce. Play it on the web with
// `?demo=<url of this file>`; see docs/AUTOMATION.md for every field.
//
// Times are demo milliseconds. Each op names what it aims at by anchor (a `dvui.tag`), never by
// pixel, so the tape plays at any window size.
.{
    .name = "hello",
    .title = "Hello from a tape",
    .keyframes = .{
        .{
            .root = "demo://hello",
            .files = .{
                .{ .path = "hello.md", .text = "# Hello\n\nThis file came from a tape.\n" },
            },
            .open = .{"hello.md"},
            .settings = .{
                .{ .owner = "markdown", .key = "default_md_view", .value = ".split" },
            },
        },
    },
    .chapters = .{
        .{ .at = 0, .title = "Hello" },
        .{ .at = 6000, .title = "Typing" },
    },
    .captions = .{
        .{ .at = 300, .ms = 5200, .title = "Hello from a tape", .text = "Nothing here is compiled in: this demo is a ZON file the page fetched.", .place = .middle, .on = "region:Main" },
        .{
            .at = 6000,
            .ms = 5400,
            .text = "Every keystroke is a real one — the preview follows along.",
            // A callout beside where the words go, clear of them and of the preview.
            .near = "text.end:demo://hello/hello.md",
            .clear = .{ "text.body:demo://hello/hello.md", "text.preview:demo://hello/hello.md" },
        },
    },
    .ops = .{
        .{ .at = 0, .do = .{ .keyframe = 0 } },
        .{ .at = 0, .do = .{ .wait = .{ .until = .idle } } },
        .{ .at = 0, .do = .{ .wait = .{ .until = .{ .shown = "text.end:demo://hello/hello.md" } } } },
        .{ .at = 4400, .ms = 900, .do = .{ .move = .{ .tag = "text.end:demo://hello/hello.md" } } },
        .{ .at = 5460, .do = .{ .press = .left } },
        .{ .at = 5570, .do = .{ .release = .left } },
        .{ .at = 6000, .ms = 3600, .do = .{ .type = "\n- written by a tape\n- played by fizzy\n" } },
        .{ .at = 10400, .do = .{ .key = "mod+a" } },
        .{ .at = 11400, .do = .{ .key = "right" } },
    },
}
